{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Legacy model inventory extraction payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["model_id", "model_type", "owner", "training_date", "feature_order", "code_threshold", "documented_threshold", "unknowns", "conflicts", "sources"],
  "properties": {
    "model_id": {"enum": ["MDL_CREDIT_V1", "MDL_CREDIT_V2", "MDL_CREDIT_TREE"]},
    "model_type": {"type": "string"},
    "owner": {"type": "string"},
    "training_date": {"type": "string"},
    "feature_order": {"type": "array", "items": {"type": "string"}},
    "code_threshold": {"type": "number"},
    "documented_threshold": {"type": "number"},
    "unknowns": {"type": "array", "items": {"type": "string"}},
    "conflicts": {"type": "array", "items": {"type": "object"}},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "line_start", "line_end", "excerpt"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "line_start": {"type": "integer", "minimum": 1},
          "line_end": {"type": "integer", "minimum": 1},
          "excerpt": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
